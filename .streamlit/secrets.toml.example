# Copy to .streamlit/secrets.toml for local secret testing, OR paste these
# into the Streamlit Community Cloud "Secrets" box for deployment.
# secrets.toml is gitignored — never commit real values.

# Cloud Postgres/PostGIS connection (Supabase / Neon / Railway).
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Google Earth Engine
GEE_PROJECT = "rmtumon"

# GEE service account (for headless auth on the server).
# Create at console.cloud.google.com, register it for Earth Engine, download
# the JSON key, then paste the client_email and the ENTIRE JSON below.
GEE_SERVICE_ACCOUNT = "ee-runner@rmtumon.iam.gserviceaccount.com"
GEE_KEY_JSON = '''
{
  "type": "service_account",
  "project_id": "rmtumon",
  "...": "paste the full downloaded key JSON here"
}
'''
